NODE_ENV=development
PORT=3000
APP_TIMEZONE=Africa/Johannesburg
MAX_AGENT_TOOL_TURNS=3

TWILIO_PUBLIC_WEBHOOK_URL=https://your-public-host.example/webhooks/twilio/
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_ALLOWED_WHATSAPP_SENDER=whatsapp:+27000000000
APP_INTERNAL_USER_ID=replace-with-opaque-internal-user-id

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
MODEL_TIMEOUT_MS=30000

COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DATABASE_NAME=tjabane
COSMOS_SESSIONS_CONTAINER=sessions
COSMOS_INBOUND_MESSAGES_CONTAINER=inboundMessages

INVESTEC_BASE_URL=https://your-investec-api-base.example/
INVESTEC_TOKEN_URL=https://your-investec-token-endpoint.example/
INVESTEC_CLIENT_ID=replace-with-investec-client-id
INVESTEC_CLIENT_SECRET=replace-with-investec-client-secret
INVESTEC_API_KEY=replace-with-investec-api-key
INVESTEC_TIMEOUT_MS=10000
