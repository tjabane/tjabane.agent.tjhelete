{
  "name": "tjabane-agent-tjhelete",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "dev:api": "npm run dev --workspace @tjabane-agent-tjhelete/api",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start:api": "npm run start --workspace @tjabane-agent-tjhelete/api",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript-eslint": "8.63.0"
  }
}
